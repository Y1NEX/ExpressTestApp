# Copy to .env in the repository root. These are LOCAL learning defaults.
POSTGRES_DB=snippets
POSTGRES_USER=snippets
POSTGRES_PASSWORD=local-snippets-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://snippets:local-snippets-password@localhost:5433/snippets
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Replace with a random value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-this-with-at-least-32-random-characters
WEB_ORIGIN=http://localhost:5173
# Provisioned by npm run owner:create; never exposed by an API registration route.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-your-own-long-password
